# TickerTracker - Production Environment Variables Example
# Rinomina questo file in .env per il deploy in produzione

# ==========================================
# Core App Settings
# ==========================================
ENVIRONMENT=production
SECRET_KEY=your_super_secret_production_key_here

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=tt_prod_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=tickertracker_prod

# ==========================================
# Backup & Disater Recovery
# ==========================================
# Chiave simmetrica per la crittografia dei backup (Generare usando Fernet/AES 256)
BACKUP_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Path del JSON relativo alla Service Account di Google Drive per l'upload
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=/app/credentials/google_drive_sa.json

# ==========================================
# Frontend Configuration
# ==========================================
# In produzione l'Nginx esegue proxy_pass locale, instradando tramite lo stesso host
VITE_API_BASE_URL=/api

# Feature flags
USE_STALE_CACHE=false
