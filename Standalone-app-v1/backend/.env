# TickerTracker Backend Configuration
# Local Development Environment

# ========== Environment Configuration ==========
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# ========== Database Configuration ==========
# PostgreSQL connection for local Docker container
# Matches credentials from docker-compose.base.yml
DATABASE_URL=postgresql+asyncpg://tickertracker:devpassword@localhost:5432/tickertracker_dev

# ========== External API Configuration ==========
YAHOO_CACHE_TTL=3600

# Google Gemini API key - Get it from: https://ai.google.dev/
# Optional for now (AI features)
GEMINI_API_KEY=placeholder-key

# Finnhub API key - Optional
FINNHUB_API_KEY=placeholder-key

# ========== Google Drive Configuration ==========
# Optional for local development
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "placeholder"}
DRIVE_FOLDER_ID=placeholder-folder-id

# ========== Security Configuration ==========
# Development keys (DO NOT use in production!)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
