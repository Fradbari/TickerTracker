# TickerTracker Backend Configuration
# Copy this file to .env and fill in the required values for your environment
# NEVER commit .env to git - it contains sensitive data!

# ========== Environment Configuration ==========
# Possible values: local, staging, production
ENVIRONMENT=local

# Enable debug mode (should be False in production)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========== Database Configuration ==========
# For local development with Docker (recommended):
DATABASE_URL=postgresql+asyncpg://tickertracker:devpassword@localhost:5432/tickertracker_dev

# Alternative: SQLite for quick testing (not recommended for production features):
#   DATABASE_URL=sqlite:///./tickertracker.db

# For production, use your actual PostgreSQL credentials:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# ========== External API Configuration ==========
# Yahoo Finance cache TTL in seconds (3600 = 1 hour)
YAHOO_CACHE_TTL=3600

# Google Gemini API key - Get it from: https://ai.google.dev/
# Required for AI features
GEMINI_API_KEY=your-gemini-api-key-here

# Finnhub API key - Get it from: https://finnhub.io/
# Optional, used for advanced market data
FINNHUB_API_KEY=your-finnhub-api-key-here

# ========== Google Drive Configuration ==========
# Google Service Account JSON key (as JSON string, not file path)
# To generate:
# 1. Go to https://console.cloud.google.com/
# 2. Create a service account
# 3. Generate a JSON key
# 4. Paste the entire JSON content here (single line)
# Example: {"type": "service_account", "project_id": "...", ...}
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "..."}

# Google Drive folder ID where data will be stored
# Find it in the URL: https://drive.google.com/drive/folders/{DRIVE_FOLDER_ID}
DRIVE_FOLDER_ID=your-drive-folder-id-here

# ========== Security Configuration ==========
# Encryption key for sensitive data
# Generate with: openssl rand -hex 32
# Must be 64 hex characters (32 bytes)
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# JWT secret for authentication tokens
# Generate with: openssl rand -hex 32
# Must be 64 hex characters (32 bytes)
JWT_SECRET=your-64-character-hex-jwt-secret-here

# ========== Security Middleware [Task 3.1] ==========
# Enable API Key authentication (recommended in production, leave false in local dev)
ENABLE_API_KEY_AUTH=false

# API Key value (required when ENABLE_API_KEY_AUTH=true)
# Generate with: openssl rand -hex 32
API_KEY=

# Comma-separated paths exempt from API Key validation
API_KEY_EXEMPT_PATHS=/health,/health/ready,/health/db,/docs,/openapi.json,/redoc

# Content-Security-Policy header value (leave empty to disable the header)
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'

# Enable structured request logging via structlog (disable in tests to reduce noise)
REQUEST_LOG_ENABLED=true

# ========== Rate Limiting [Task 3.2] ==========
# Redis URL for distributed rate limiting (slowapi + redis-py)
# For local Docker dev: redis://localhost:6379/0
# Falls back to in-memory storage automatically if Redis is unreachable
REDIS_URL=redis://localhost:6379/0

# Enable slowapi rate limiting globally (set to false in tests or local dev if preferred)
RATE_LIMIT_SLOWAPI_ENABLED=true

# Default limit applied to every endpoint not decorated with a specific limit
RATE_LIMIT_DEFAULT=100/minute

# Limit for AI chat endpoint (POST /api/chat) — conservative because LLM calls are expensive
RATE_LIMIT_CHAT=10/minute

# Limit for creating estimates (POST /api/estimates)
RATE_LIMIT_ESTIMATES_POST=30/minute

# Limit for market price lookups (GET /api/market/price/{ticker})
RATE_LIMIT_MARKET_PRICE=60/minute

# Comma-separated IPs exempt from rate limiting (loopback always included)
# Example: RATE_LIMIT_WHITELIST_IPS=["127.0.0.1","::1","10.0.0.1"]
RATE_LIMIT_WHITELIST_IPS=["127.0.0.1","::1"]
